<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Jove.SurvivalBrief</AssemblyName>
    <RootNamespace>Jove.SurvivalBrief</RootNamespace>
    <Version>0.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- 游戏程序集目录：可用 -p:TimberbornManaged=... 覆盖 -->
    <TimberbornManaged Condition="'$(TimberbornManaged)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Timberborn/Timberborn.app/Contents/Resources/Data/Managed</TimberbornManaged>
  </PropertyGroup>

  <!-- The game loads the mod from Documents/Timberborn/Mods/SurvivalBrief. Override path from the command line if needed. -->
  <PropertyGroup>
    <ModInstallDir Condition="'$(ModInstallDir)' == ''">$(HOME)/Documents/Timberborn/Mods/SurvivalBrief</ModInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Timberborn.GameCycleSystem">
      <HintPath>$(TimberbornManaged)/Timberborn.GameCycleSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
