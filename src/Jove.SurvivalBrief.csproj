  <ItemGroup>
    <EmbeddedResource Include="github-mark.png">
      <LogicalName>Jove.SurvivalBrief.github-mark.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="DeployToGameMod" AfterTargets="Build">
    <ItemGroup>
      <_LocalizationFiles Include="$(MSBuildProjectDirectory)/../Localizations/*.csv" />
    </ItemGroup>
    <MakeDir Directories="$(ModInstallDir)/Scripts;$(ModInstallDir)/Localizations" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModInstallDir)/Scripts" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)/../Scripts" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../manifest.json" DestinationFolder="$(ModInstallDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../thumbnail.png" DestinationFolder="$(ModInstallDir)" />
    <Copy SourceFiles="@(_LocalizationFiles)" DestinationFolder="$(ModInstallDir)/Localizations" />
  </Target>

</Project>
